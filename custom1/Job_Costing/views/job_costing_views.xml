<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cost_sheet_tree" model="ir.ui.view">
        <field name="name">cost.sheet.tree</field>
        <field name="model">cost.sheet</field>
        <field name="arch" type="xml">
            <tree string="cost sheet">
                <field name="name"/>
                <field name="project_id"/>
                <field name="create_date"/>
                <field name="close_date"/>
            </tree>
        </field>
    </record>

    <record id="view_cost_sheet_form" model="ir.ui.view">
        <field name="name">cost.sheet.form</field>
        <field name="model">cost.sheet</field>
        <field name="arch" type="xml">
            <form string="cost sheet">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_approved" type="object" string="Approved" invisible="state != 'confirmed'" class="oe_highlight"/>
                    <button name="action_done" type="object" string="Done" invisible="state != 'approved'" class="oe_highlight"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'done' or state == 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,approved,done" />
                </header>
                    <sheet>
                      <group>
                        <group>
                            <field name="reference" readonly="True"/>
<!--                            <field name="total_quantity" readonly="1" />-->
                            <field name="total_material_subtotal" readonly="1" />
                            <field name="total_labour_subtotal" readonly="1" />
                            <field name="total_overhead_subtotal" readonly="1" />



                        </group>
                       <group>
                           <field name="name"/>
                           <field name="project_id"/>
                           <field name="create_date"/>
                           <field name="close_date"/>
                       </group>
                    </group>
                    <notebook>
                        <page name="material_page" string="Material">
                            <field name="material_line_ids" string="Material line">
                                <tree editable="bottom">
                                    <field name="date"/>
                                    <field name="job_type_id"/>
                                    <field name="product_id" domain="[('type', '=', 'product')]" options="{'no_create': True}"/>
<!--                                    <field name="product_id" widget="selection"/>-->

                                    <field name="description"/>
                                    <field name="reference"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="invoiced_qty"/>
                                    <field name="unit_price"/>
                                    <field name="actual_purchase_qty"/>
                                    <field name="material_subtotal"/>
                                </tree>
                            </field>
                        </page>
                        <page name="labour" string="Labour">
                            <field name="labour_line_ids" string="Labour line">
                            <tree editable="bottom">
                                <field name="date"/>
                                <field name="job_type_id"/>
                                <field name="product_id" domain="[('type', '=', 'consu')]"/>
                                <field name="description"/>
                                <field name="reference"/>
                                <field name="hours"/>
                                <field name="invoiced_qty"/>
                                <field name="unit_price"/>

                                <field name="labour_subtotal" readonly="1"/>
<!--                                <field name=""/>-->
                            </tree>
                            </field>
                        </page>
                        <page name="overhead" string="Overhead">
                            <field name="overhead_line_ids" string="Over-head line">
                            <tree editable="bottom">
                                <field name="date"/>
                                <field name="job_type_id"/>
                                <field name="product_id" on_change="1" domain="[('type', '=', 'service')]"/>
                                <field name="description"/>
                                <field name="reference"/>
                                <field name="basis"/>
                                <field name="quantity"/>
                                <field name="uom_id" readonly="1"/>
                                <field name="invoiced_qty"/>
                                <field name="unit_price"/>
                                <field name="actual_purchase_qty"/>
                                <field name="actual_invoice_qty"/>
                                <field name="overhead_subtotal"/>
                             </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cost_sheet" model="ir.actions.act_window">
        <field name="name">cost sheet</field>
        <field name="res_model">cost.sheet</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_noncontent_smiling_face">
                Create a new cost sheet
            </p>
        </field>
    </record>


</odoo>
